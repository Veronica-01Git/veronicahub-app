# Banco de dados (Neon Postgres — projeto separado do negocio-da-china-app).
# A mesma connection string serve pro Prisma CLI (migrate) e pro driver HTTP
# em runtime (@neondatabase/serverless via @prisma/adapter-neon).
DATABASE_URL=

# Segredo da sessão selada (TanStack Start built-in session). >= 32 chars.
# Gerar com: openssl rand -base64 32
SESSION_SECRET=

# Resend — envio do código de login por e-mail. Domínio veronicahub.com
# precisa estar verificado (SPF/DKIM) no painel Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Mercado Pago — MESMAS credenciais de produção do negocio-da-china-app
# (mesmo dinheiro, mesma conta MP; contas de usuário continuam separadas).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública alcançável pelo Mercado Pago para o webhook. Em produção, o
# próprio domínio (https://veronicahub.com). Em dev local, a URL de um túnel
# (cloudflared/ngrok) apontando pro `vite dev`.
WEBHOOK_BASE_URL=

# Geração real de imagem (Nano Banana Pro) via API do Higgsfield — ver
# src/lib/higgsfield.ts.
HF_CREDENTIALS=

# Chave de API da Anthropic (console.anthropic.com). Usada por:
#   - o agente de WhatsApp da Express Entulho, como PROVEDOR PRINCIPAL
#     (src/lib/whatsapp-provedores.ts); sem ela o agente ainda atende, pela
#     Groq, e o /api/whatsapp/diagnostico diz isso com todas as letras
#   - scripts/reprocess-covers.mjs (rodado local, nunca em produção)
# O chat da Veronica e o Veronica Wire seguem no Groq (ver GROQ_API_KEY).
ANTHROPIC_API_KEY=

# Opcional. Modelo do agente de WhatsApp. Padrão: claude-opus-5.
# Existe como variável para que trocar de modelo não exija deploy — nome de
# modelo é a peça que mais quebra (dois incidentes de 404 em 19/09).
# Alternativa mais barata para este uso: claude-haiku-4-5
# (US$ 1 / US$ 5 por milhão de tokens de entrada / saída, contra US$ 5 / US$ 25).
ANTHROPIC_MODEL_AGENTE=

# Gera o rascunho das matérias do Veronica Wire (draftArticleContent em
# src/lib/articles-server.ts, modelo "groq/compound" — tem busca na web
# nativa) e as respostas do chat da Veronica (veronicaChat em
# src/lib/veronica-server.ts, modelo "qwen/qwen3.6-27b"). Chave grátis
# via console.groq.com/keys, sem cartão de crédito (trocado do Gemini —
# cota travada mesmo com faturamento configurado — e da Anthropic, sem
# crédito; ver PROGRESSO.md). Precisa ser configurada em produção via
# `wrangler secret put GROQ_API_KEY` (roda no Worker, não no GitHub
# Actions).
GROQ_API_KEY=

# Opcional. QUARTO e último elo da cadeia do agente de WhatsApp
# (src/lib/whatsapp-provedores.ts), atrás da Anthropic e das duas Groq.
#
# SIM, O GEMINI JÁ FOI DESCARTADO AQUI ANTES — a nota do GROQ_API_KEY acima
# registra a cota travada mesmo com faturamento configurado. O que mudou não
# foi o Gemini: foi a posição dele. Antes era provedor único, e travar
# significava o site mudo. Agora é o quarto da fila, chamado só quando as
# três contas anteriores falharam no mesmo pedido — se travar de novo, o
# custo é uma tentativa perdida, não uma conversa perdida.
#
# Por que vale mesmo assim: em setembro/2026 quase todo tier gratuito caiu
# (a Mistral encerrou o de 1 bilhão de tokens/mês, a Cerebras passou a exigir
# cartão, o GitHub Models foi desligado). O Flash-Lite ainda dá algumas
# centenas de requisições por dia, em conta e cobrança separadas da Groq —
# e independência de conta é o que faz uma cota estourada não virar silêncio.
#
# Chave grátis em aistudio.google.com/apikey, sem cartão. Em produção:
# `wrangler secret put GEMINI_API_KEY`.
GEMINI_API_KEY=

# Opcional. Modelo do Gemini na cadeia. Padrão: gemini-3.1-flash-lite —
# identificador conferido na documentação do Google, não lembrado de cabeça.
# A faixa Flash-Lite é a escolhida porque é a de cota diária mais folgada;
# a Flash comum foi cortada para poucas dezenas de requisições por dia.
GEMINI_MODELO_AGENTE=

# --- Voz da agente de WhatsApp (src/lib/whatsapp-voz.ts) ---------------
#
# Opcional. Sem as DUAS variáveis abaixo a agente responde em texto
# exatamente como antes — nenhuma linha do caminho de voz chega a rodar.
#
# Por que vale: cliente de caçamba conversa por áudio, dirigindo ou no meio
# da obra. Receber texto de volta é responder na língua errada.
#
# A REGRA QUE NÃO SE NEGOCIA: resposta que cita VALOR vai em texto, nunca só
# em áudio. Áudio não se relê, e quem ouviu "duzentos e vinte" como
# "duzentos e doze" fecha negócio errado. Quem decide é decidirVoz(), e há
# teste travando isso em tests/whatsapp-voz.test.mjs.
#
# Chave em elevenlabs.io (Profile > API Keys). Em produção:
# `wrangler secret put ELEVENLABS_API_KEY`.
ELEVENLABS_API_KEY=

# Id da voz escolhida, do painel da ElevenLabs (Voices > a voz > ID). É esta
# variável que define COMO a Veronica soa; sem ela a voz fica desligada.
ELEVENLABS_VOICE_ID=

# Opcional. Modelo de síntese. Padrão: eleven_multilingual_v2, que fala
# português do Brasil. Existe como variável pelo mesmo motivo dos modelos de
# texto: nome de modelo é a peça que mais quebra sem aviso.
ELEVENLABS_MODELO=

# Avatar ao vivo da Veronica (src/lib/vidu-live-server.ts) — Vidu S2
# Realtime, plataform.vidu.com/docs/vidu-s1. Chave no formato vda_xxx,
# obtida no console do Vidu. Em produção: `wrangler secret put VIDU_API_KEY`
# (mesmo caminho de GROQ_API_KEY/ELEVENLABS_API_KEY acima).
#
# CONFIRME antes de gerar: a chave precisa ser do ambiente Global
# (api.vidu.com), não China (api.vidu.cn) — usuário no Brasil com chave
# China dá 401/403 (ver FAQ do Vidu). VIDU_ENVIRONMENT abaixo só troca o
# host se um dia isso mudar; a chave em si já nasce presa a um ambiente.
VIDU_API_KEY=

# Opcional. "global" (padrão, api.vidu.com) ou "china" (api.vidu.cn).
VIDU_ENVIRONMENT=

# Opcional. Imagem de referência do personagem (avatar.image_uri) — URL
# pública, HTTPS. SEM ISSO, cai no holograma atual (avatar-hologram.webp),
# que é só placeholder visual, não a imagem final aprovada. Não subir aqui
# nenhuma imagem sem confirmar direito de uso comercial dela.
VIDU_AVATAR_IMAGE_URI=

# Opcional. Id da voz clonada dentro do Vidu (POST /live/v1/voices/clone,
# a partir de uma amostra da voz ElevenLabs acima). Sem isso, usa a voz
# default do Vidu ("Tina") — funciona, mas não é a voz da Veronica.
VIDU_VOICE_ID=

# Painel admin (/admin, ver src/lib/admin-server.ts). Lista de e-mails
# separados por vírgula que viram admin automaticamente no primeiro acesso
# ao painel (ex.: ADMIN_EMAILS=voce@exemplo.com). Vazio = ninguém tem acesso.
ADMIN_EMAILS=

# Autentica o endpoint /api/cron/generate-article (src/lib/article-cron.ts)
# — quem chama é o GitHub Actions (.github/workflows/generate-article.yml,
# a cada 5h), não um admin logado. Gerar com: openssl rand -base64 32.
# Precisa do MESMO valor cadastrado como secret CRON_SECRET no GitHub
# Actions do repositório (Settings → Secrets and variables → Actions) e,
# em produção, via `wrangler secret put CRON_SECRET`.
CRON_SECRET=

# Busca de foto real pra capa das matérias do Wire (scripts/fetch-cover-photo.mjs
# e scripts/reprocess-covers.mjs) — Pexels primeiro, Pixabay como segunda
# fonte (opcional). NÃO são secrets do Worker: a busca roda no GitHub
# Actions, então cadastre só lá (Settings → Secrets and variables →
# Actions), nunca via `wrangler secret put`. Chave grátis instantânea em
# pexels.com/api e pixabay.com/api/docs/.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Publicação oficial da Wire TV no Instagram pela Meta Graph API. A conta
# @wire__tv precisa ser profissional e estar autorizada no app da Meta.
# O token é segredo exclusivo do Worker: nunca use prefixo VITE_ e nunca o
# exponha no navegador. Deixe AUTOPUBLISH=false até validar o primeiro post
# manual pelo painel /admin/artigos.
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_GRAPH_HOST=graph.facebook.com
META_GRAPH_API_VERSION=v24.0
META_INSTAGRAM_AUTOPUBLISH=false

# Checkout público e hospedado do pack Voz e Narração IA. Enquanto vazio,
# a página usa o atendimento por WhatsApp/Pix. Aceita somente URL HTTPS.
# Não coloque tokens, chaves privadas ou segredos nesta variável VITE_*.
VITE_PROMPT_PACK_VOICE_CHECKOUT_URL=

# --- Agente de WhatsApp — Express Entulho (VH-AUT-WA-2026-000001) ---
# O agente roda em NÚMERO DEDICADO. O número atual da empresa não é migrado
# nem cadastrado aqui — ver AGENTS.md.
#
# Para testar sem comprar chip: use o número de teste que a Meta fornece como
# remetente e cadastre seu celular como destinatário no painel.
#
# Painel: Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Configurações > Básico > Chave Secreta do Aplicativo. Assina o webhook.
WHATSAPP_APP_SECRET=
# Você inventa esta string e repete no painel ao cadastrar a URL do webhook.
WHATSAPP_VERIFY_TOKEN=
# Opcional. Padrão: v21.0
WHATSAPP_GRAPH_VERSION=
